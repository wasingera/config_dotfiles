;; {"wifi": ..., "vpn": ...}, updated on NetworkManager events
(deflisten network :initial '{"wifi": "", "vpn": ""}'
    `./scripts/network.sh`)

(include "./vpn.yuck")
(include "./wifi.yuck")

(defwidget network_container []
    (box
        :class "network_container"
        (box
            :class "vpn"
            (vpn_widget)
        )

        (box
            :class "wifi"
            (wifi_widget)
        )
    )
)
