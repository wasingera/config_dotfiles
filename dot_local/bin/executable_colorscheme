#!/usr/bin/env bash
# Switch the desktop between its light and dark colour schemes.
#
#   colorscheme dark|light|toggle
#   colorscheme                     re-apply the current mode (wallpaper does, after
#                                   setting one)
#
# chezmoi renders every mode's colour files into ~/.config/colorscheme/<mode>/
# (from .chezmoitemplates/colors/ and the palette in .chezmoidata/). This copies
# the chosen mode's files into ~/.local/state/colorscheme/current/, where the
# tools' configs import them from, with colorscheme-accents picking the accent
# pair to match the wallpaper. Then it records the mode (nvim watches it) and
# reloads whatever is running. colorscheme-solar calls it at sunrise/sunset.

set -euo pipefail

# systemd services don't have ~/.local/bin (eww) on their PATH
PATH=$HOME/.local/bin:$PATH

modes=${XDG_CONFIG_HOME:-$HOME/.config}/colorscheme
state=${XDG_STATE_HOME:-$HOME/.local/state}/colorscheme
current=$(cat "$state/mode" 2>/dev/null || echo dark)

case ${1:-$current} in
    dark | light) mode=${1:-$current} ;;
    toggle) if [[ $current == dark ]]; then mode=light; else mode=dark; fi ;;
    *)
        echo "usage: colorscheme [dark|light|toggle]" >&2
        exit 1
        ;;
esac

if [[ ! -d $modes/$mode ]]; then
    echo "colorscheme: $modes/$mode is missing; run chezmoi apply" >&2
    exit 1
fi

# Build the scheme in a staging directory: the mode's files, with the accents
# picked to match its wallpaper (or blue and mauve if that fails). That's the
# one set with the wallpaper command, else the default chezmoi rendered. Then
# rename each file over the current one, so a tool that is watching never
# reads a half-written file.
mkdir -p "$state/current"
staging=$(mktemp -d "$state/.staging.XXXXXX")
trap 'rm -rf "$staging"' EXIT
cp "$modes/$mode"/* "$staging"
chosen=$(cat "$state/wallpaper/$mode" 2>/dev/null || true)
if ! colorscheme-accents "$staging" ${chosen:+"$chosen"}; then
    echo "colorscheme: keeping the default accents" >&2
    cp "$modes/$mode"/* "$staging"
fi
for file in "$staging"/*; do
    mv -f "$file" "$state/current/${file##*/}"
done
printf '%s\n' "$mode" >"$state/mode"

# Reload what's running; anything that isn't is skipped quietly.
if eww ping >/dev/null 2>&1; then eww reload >/dev/null 2>&1 || true; fi
if pgrep -x dunst >/dev/null; then dunstctl reload || true; fi
# SIGUSR1 makes kitty re-read its config, including the colours
pkill -USR1 -x kitty || true
# zathura re-reads its config, colours included, when asked over D-Bus
for name in $(busctl --user list --no-legend 2>/dev/null | awk '$1 ~ /^org\.pwmt\.zathura\./ { print $1 }'); do
    busctl --user call "$name" /org/pwmt/zathura org.pwmt.zathura SourceConfig >/dev/null 2>&1 || true
done
# tmux only reads its config at startup, so source the colours into the running server
if tmux info >/dev/null 2>&1; then
    tmux source-file "$state/current/tmux.conf" \; refresh-client -S >/dev/null 2>&1 || true
fi
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then hyprctl reload >/dev/null 2>&1 || true; fi
gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode" 2>/dev/null || true
gtk_theme=$(sed -n 's/^gtk-theme-name=//p' "$state/current/gtk3.ini" 2>/dev/null)
if [[ -n $gtk_theme ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
fi
wallpaper=$(sed -n 's/^ *path = //p' "$state/current/hyprpaper.conf" 2>/dev/null)
if [[ -n $wallpaper ]] && pgrep -x hyprpaper >/dev/null; then
    hyprctl hyprpaper wallpaper ",$wallpaper" >/dev/null 2>&1 || true
fi
# hyprlock's glass card shows this mode's wallpaper blurred; render it for the next lock
card=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/hyprlock_card.py
if [[ -x $card ]]; then "$card" || true; fi
