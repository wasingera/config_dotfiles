;; ==== Variables ====
;; {"volume": N, "muted": bool}, updated on PulseAudio/PipeWire events
(deflisten volume :initial '{"volume": 50, "muted": false}'
    `./scripts/volume.sh`)

;; ==== Widgets ====
(defwidget volume_mute []
    (button
        :class "volume_button"
        :onclick "pamixer --toggle-mute"
        {volume.muted ? "婢" : "墳"}
    )
)

(defwidget volume_slider []
    (scale
        :class "volume_slider"
        :value {volume.volume}
        :min 0
        :max 100
        :onchange "pamixer --set-volume {}"
    )
)

(defwidget volume []
    (box
        :class "volume"
        :space-evenly false
        :valign "center"
        :halign "center"
        (volume_mute)
        (volume_slider)
    )
)

