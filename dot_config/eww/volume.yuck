;; ==== Variables ====
;; {"volume": N, "muted": bool, "icon": ...} for the default output, updated
;; on PulseAudio/PipeWire events
(deflisten volume :initial '{"volume": 50, "muted": false, "icon": ""}'
    `./scripts/volume.sh`)

;; The volume mixer popup's state, in two parts (see scripts/mixer.sh): the
;; outputs and apps, which change only as they come and go, and the apps'
;; volumes. A for rebuilds its rows on any change to its variable, which would
;; drop a slider while it's dragged.
(deflisten mixer :initial '{"outputs": [], "apps": [], "app_glyph": ""}'
    `./scripts/mixer.sh rows`)
(deflisten mixer_levels :initial '{}'
    `./scripts/mixer.sh levels`)

;; ==== Widgets ====
(defwidget volume_mute []
    (button
        :class "volume_button"
        :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        :onrightclick "./scripts/volume_mixer.sh &"
        {volume.icon}
    )
)

(defwidget volume_slider []
    (scale
        :class "volume_slider"
        :value {volume.volume}
        :min 0
        :max 100
        :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"
    )
)

(defwidget volume []
    (box
        :class "volume ${volume.muted ? 'muted' : ''}"
        :space-evenly false
        :valign "center"
        :halign "center"
        (volume_mute)
        (volume_slider)
    )
)
;; ==== Mixer popup ====

;; An output: click it to make it the default. PipeWire moves playing streams
;; to it.
(defwidget mixer_output [o]
    (button
        :class "mixer-output ${o.default ? 'default' : ''}"
        :onclick "pactl set-default-sink '${o.name}'"
        (box
            :space-evenly false
            (label :class "mixer-glyph" :text {o.icon})
            (label :xalign 0 :hexpand true :limit-width 30 :text {o.label}))
    )
)

;; An app: its icon, name and volume over a slider, and a mute button. A is
;; the app's entry in mixer.apps; its volume comes from mixer_levels.
(defwidget mixer_app [a]
    (box
        :class "mixer-app ${mixer_levels?.[a.id]?.muted ?: false ? 'muted' : ''}"
        :space-evenly false
        (box
            :class "mixer-icon"
            (image :visible {a.icon != ""} :path {a.icon}
                :image-width 24 :image-height 24)
            (label :visible {a.icon == ""} :text {mixer.app_glyph}))
        (box
            :orientation "v"
            :hexpand true
            :space-evenly false
            (box
                :space-evenly false
                (label :class "mixer-name" :xalign 0 :hexpand true :limit-width 26
                    :text {a.name})
                (label :class "mixer-percent" :text "${mixer_levels?.[a.id]?.volume ?: 0}%"))
            (scale
                :class "mixer-slider"
                :value {mixer_levels?.[a.id]?.volume ?: 0}
                :min 0
                :max 100
                :onchange "pactl set-sink-input-volume ${a.id} {}%")
        )
        (button
            :class "mixer-mute"
            :onclick "pactl set-sink-input-mute ${a.id} toggle"
            {mixer_levels?.[a.id]?.glyph ?: ""})
    )
)

;; Hangs from the bar button like notification_history (see notifications.yuck),
;; with transparent buttons around the card that close it
(defwindow volume_mixer [top right]
    :monitor 0
    :geometry (geometry
        :anchor "top left"
        :width "100%"
        :height "100%"
    )
    :stacking "overlay"
    :exclusive false
    :namespace "eww-mixer"

    (box
        :orientation "v"
        :space-evenly false
        (button :class "backdrop" :height {top + 5} :onclick "eww close volume_mixer")
        (box
            :space-evenly false
            (button :class "backdrop" :hexpand true :onclick "eww close volume_mixer")
            (box
                :class "mixer-card"
                :orientation "v"
                :space-evenly false
                (label :class "mixer-header" :xalign 0 :text "Output")
                ;; Each list in its own box: eww adds a for's widgets after
                ;; its siblings, not in its place
                (box
                    :orientation "v"
                    :space-evenly false
                    (for o in {mixer.outputs}
                        (mixer_output :o o)))
                (box :class "mixer-divider")
                (label :class "mixer-header" :xalign 0 :text "Applications")
                ;; From mixer_levels rather than mixer.apps: eww starts the
                ;; listeners of the variables the window uses as it opens,
                ;; before the for has any rows using mixer_levels
                (label
                    :class "mixer-empty"
                    :xalign 0
                    :visible {objectlength(mixer_levels) == 0}
                    :text "Nothing playing")
                (box
                    :orientation "v"
                    :space-evenly false
                    (for a in {mixer.apps}
                        (mixer_app :a a)))
            )
            (button :class "backdrop" :width right :onclick "eww close volume_mixer")
        )
        (button :class "backdrop" :vexpand true :onclick "eww close volume_mixer")
    )
)
