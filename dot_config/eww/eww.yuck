(include "./clock.yuck")
(include "./workspaces.yuck")
(include "./volume.yuck")
(include "./powerbar.yuck")
(include "./keyboard.yuck")
(include "./network_container.yuck")

(defwidget leftbar []
    (box
        :class "leftbar"
        :halign "start"

        (clock_w)
    )
)

(defwidget centerbar []
    (box
        :class "centerbar"
        :halign "center"

        (workspaces_w)
    )
)

(defwidget rightbar []
    (box
        :class "rightbar"
        :halign "end"
        :space-evenly false

        (keyboard)
        (network_container)
        (volume)
        (power)
    )
)

(defwindow top_bar
    :monitor 0
    :geometry (geometry
        :y "5px"
        :anchor "top center"
        :width "100%"
        :height: "30px"
    )

    :stacking: "bottom"
    :exclusive true
    :namespace "eww-bar"

    (centerbox :orientation "h"
        (leftbar)
        (centerbar)
        (rightbar)
    )
)
