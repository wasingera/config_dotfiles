;; ==== Variables ====
;; {"volume": N, "muted": bool, "icon": ..., "sink": ...} for the default
;; output, updated on PulseAudio/PipeWire events
(deflisten volume :initial '{"volume": 50, "muted": false, "icon": "", "sink": ""}'
    `./scripts/volume.sh`)

;; ==== Widgets ====
(defwidget volume_mute []
    (button
        :class "volume_button"
        :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        :onrightclick "./scripts/select_output.sh &"
        {volume.icon}
    )
)

(defwidget volume_slider []
    (scale
        :class "volume_slider"
        :value {volume.volume}
        :min 0
        :max 100
        :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"
    )
)

(defwidget volume []
    (box
        :class "volume ${volume.muted ? 'muted' : ''}"
        :space-evenly false
        :valign "center"
        :halign "center"
        (volume_mute)
        (volume_slider)
    )
)
