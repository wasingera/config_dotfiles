configuration{
    modes: "drun,run,window";
    icon-theme: "Papirus";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{name}";
    display-drun: " 󰀻  Apps ";
    display-run: "   Run ";
    display-window: " 󰖳  Window";
    sidebar-mode: true;
}

@theme "catppuccin"

* {
    font: "Iosevka Term Extended Bold 15px";
}

window {
    height: 350px;
    width: 550px;
    border-radius: 3px;
}

listview {
    layout: vertical;
    columns: 1;
}

element {
    padding: 5px;
    margin: 0px 15px 0px 0px;
    /* between the icon and the name */
    spacing: 11px;
    border-radius: 3px;
}

element selected {
    background-color: @surface0;
}

element-icon {
    size: 20px;
}
