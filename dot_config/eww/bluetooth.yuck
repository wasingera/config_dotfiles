;; Bluetooth off, on, or connected to a device, its Nerd Font icon, and
;; whether it's scanning for devices, updated on BlueZ events
(deflisten bluetooth :initial '{"state": "off", "icon": "", "scanning": false}'
    `./scripts/bluetooth.sh`)

;; Set by select_bluetooth.sh while it connects, pairs etc.: blinks, in a
;; different colour from a scan
(defvar bluetooth_busy false)

(defwidget bluetooth_widget []
    (button
        :onclick `./scripts/select_bluetooth.sh &`
        (label :class "net-icon ${bluetooth.state} ${bluetooth_busy ? 'busy' : bluetooth.scanning ? 'scanning' : ''}"
            :text {bluetooth.icon})
    )
)
