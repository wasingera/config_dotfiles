/* Catppuccin {{ .name }} for rofi: @base, @blue, ... Imported by the rofi themes.
 * Generated by chezmoi from .chezmoitemplates/colors/rofi.rasi. */
* {
{{- range $name, $hex := . }}{{ if ne $name "name" }}
    {{ $name }}: {{ $hex }};
{{- end }}{{ end }}
    /* the accent pair: accent for highlights, accent2 beside it */
    accent: @blue;
    accent2: @mauve;
}
