;; names and icons of the active Wi-Fi and VPN, updated on NetworkManager events
(deflisten network :initial '{"wifi": "", "wifi_icon": "", "vpn": "", "vpn_icon": ""}'
    `./scripts/network.sh`)

(include "./vpn.yuck")
(include "./wifi.yuck")

(defwidget network_container []
    (box
        :class "network_container"
        (box
            :class "vpn"
            (vpn_widget)
        )

        (box
            :class "wifi"
            (wifi_widget)
        )
    )
)
