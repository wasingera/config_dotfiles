configuration{
    modes: "drun,run,window";
    icon-theme: "Papirus";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{name}";
    display-drun: " 󰀻  Apps ";
    display-run: "   Run ";
    display-window: " 󰖳  Window";
    sidebar-mode: true;
    /* MousePrimary: a click outside the launcher closes it (see window) */
    kb-cancel: "Escape,Control+g,Control+bracketleft,MousePrimary";
}

@theme "catppuccin"

* {
    font: "Iosevka Term Extended Bold 15px";
}

/* rofi's click-to-exit does nothing on Wayland, so, like the bar menus
 * (dropdown.rasi), the window covers the screen, transparent, with the
 * launcher box in the middle. A click outside the box hits no entry and
 * falls through to kb-cancel. */
window {
    fullscreen: true;
    background-color: transparent;
    children: [ "launcher-above", "launcher-row", "launcher-below" ];
}

launcher-row {
    orientation: horizontal;
    expand: false;
    background-color: transparent;
    children: [ "launcher-left", mainbox, "launcher-right" ];
}

launcher-above, launcher-below, launcher-left, launcher-right {
    expand: true;
    background-color: transparent;
}

mainbox {
    expand: false;
    width: 550px;
    border-radius: 3px;
}

listview {
    layout: vertical;
    columns: 1;
    /* A box can't be given a height, so the launcher's comes from this */
    lines: 7;
}

element {
    padding: 5px;
    margin: 0px 15px 0px 0px;
    /* between the icon and the name */
    spacing: 11px;
    border-radius: 3px;
}

element selected {
    background-color: @surface0;
}

element-icon {
    size: 20px;
}
