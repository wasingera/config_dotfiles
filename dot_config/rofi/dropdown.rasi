/* Shared layout for the menus that drop down from eww bar buttons
 * (wifi, vpn, bluetooth, audio output, power). Each menu's theme.rasi imports this and sets:
 *   menu-color   text colour
 *   menu-width   width of the menu box
 *
 * rofi's click-to-exit does nothing on Wayland, so the window covers the
 * whole screen (transparent) and only the menu box is drawn. A click on the
 * transparent part hits no entry and falls through to kb-cancel, which
 * rofi_menu (eww/scripts/lib.sh) binds to MousePrimary. rofi_menu also sets
 * listview lines to the number of options, and menu-row's padding so the
 * menu hangs from the button that was clicked (eww/scripts/bar_anchor.py).
 *
 * Only the listview is shown; a prompt theme (wifi_password) swaps it for the
 * inputbar. */

/* Palette variables (@base, @blue, ...) of the active light/dark scheme;
 * see ~/.local/bin/colorscheme */
@import "~/.local/state/colorscheme/current/rofi.rasi"

* {
    background-color: @base;
    color: @menu-color;
}

window {
    fullscreen: true;
    background-color: transparent;
    children: [ "menu-row", "menu-below" ];
}

/* top strip: transparent filler, then the menu box. rofi_menu pads it down
 * to the button's bottom edge and in from the right to its right edge. */
menu-row {
    orientation: horizontal;
    expand: false;
    background-color: transparent;
    children: [ "menu-left", mainbox ];
}

menu-left, menu-below {
    expand: true;
    background-color: transparent;
}

mainbox {
    expand: false;
    width: @menu-width;
    /* 5px below the bar, the same gap as between its buttons */
    margin: 5px 0px 0px 0px;
    padding: 6px 0px;
    border-radius: 3px;
    children: [ listview ];
}

inputbar {
    enabled: false;
    padding: 5px 10px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt, entry {
    font: "Iosevka Term Extended Bold 15px";
}

mode-switcher {
    enabled: false;
}

listview {
    layout: vertical;
    spacing: 0px;
}

element {
    orientation: horizontal;
    padding: 5px 5px;
    margin: 0px 5px;
    children: [ element-text ];
    border-radius: 3px;
}

element selected {
    background-color: @surface0;
}

/* rows passed with -a, e.g. the connected network */
element normal.active, element alternate.active, element selected.active {
    text-color: @green;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    font: "Iosevka Term Extended Bold 15px";
    margin: 0px 0px 0px 5px;
}
