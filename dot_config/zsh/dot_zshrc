# yazi: cd into the last browsed directory on quit
#? y [DIR] - browse files in yazi, then cd to where you left off
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

## Help ##
# Lists the "#?" lines of this file and local.zsh, skipping commands this
# machine doesn't define (e.g. the tmux ones without tmux).
#? help [NAME] - list these commands, or only NAME
function help() {
    emulate -L zsh
    setopt extended_glob
    local file line usage name b= n=
    local -a usages descs
    local -i i w=0
    for file in $ZDOTDIR/.zshrc $ZDOTDIR/local.zsh; do
        [[ -r $file ]] || continue
        for line in "${(@f)$(<$file)}"; do
            [[ $line == [[:space:]]#'#? '* ]] || continue
            line=${line#*'#? '}
            usage=${line%% - *}
            name=${usage%% *}
            [[ -z $1 || $name == $1 ]] || continue
            (( $+functions[$name] || $+aliases[$name] )) || continue
            usages+=$usage
            descs+=${line#* - }
            (( w = $#usage > w ? $#usage : w ))
        done
    done
    if (( ! $#usages )); then
        print -u2 "help: ${${1:+no command $1}:-nothing to list}"
        return 1
    fi
    [[ -t 1 ]] && b=${(%):-%B} n=${(%):-%b}
    for i in {1..$#usages}; do
        print -r -- "$b${(r:w:)usages[i]}$n  ${descs[i]}"
    done
}

## Machine-specific settings (untracked; see README) ##
[ -f "$ZDOTDIR/local.zsh" ] && source "$ZDOTDIR/local.zsh"

# zoxide: z <dir>, zi for interactive picker (keep near end of file)
#? z DIR - jump to a directory you've visited (zoxide)
#? zi - pick a visited directory to jump to (zoxide)
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
