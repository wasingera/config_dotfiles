(defpoll time
  :interval "1s"
  `date +"%a %b %d | %H:%M"`)

;; (defwidget clock_text []
;;   (box
;;     :class "clock_class"
;;     :orientation "h"
;;     time))

(defwidget clock_w []
  (box
    :orientation "h"
    :halign "center"
    :class "clock"

    time)
)

