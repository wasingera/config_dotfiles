;; {"label": ..., "keymap": ...} for the main keyboard, updated on layout switches
(deflisten keyboard_layout :initial '{"label": "", "keymap": ""}'
    `./scripts/keyboard.sh`)

(defwidget keyboard []
    (box
        :class "keyboard"
        (button
            :tooltip {keyboard_layout.keymap}
            :onclick "hyprctl switchxkblayout all next"
            {keyboard_layout.label})
    )
)
