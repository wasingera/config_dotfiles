;; dunst's notification history and how many of them are unseen, updated on
;; dunst's D-Bus signals; see scripts/notifications.sh
(deflisten notifications :initial '{"icon": "", "unseen": 0, "newest": 0, "entries": []}'
    `./scripts/notifications.sh`)

;; The bar button: a bell, with the count of notifications in the history.
;; Peach while some came in since the history was last opened.
(defwidget notifications_widget []
    (box
        :class "notifications"
        (button
            :onclick "./scripts/notification_history.sh &"
            (box
                :space-evenly false
                (label :class "net-icon ${notifications.unseen > 0 ? 'unseen' : ''}"
                    :text {notifications.icon})
                ;; Two digits, 00 to 20, so the pill keeps its width
                (label :class "notif-count ${notifications.unseen > 0 ? 'unseen' : ''}"
                    :text {arraylength(notifications.entries) < 10
                        ? "0${arraylength(notifications.entries)}"
                        : arraylength(notifications.entries)})
            )
        )
    )
)

;; One history entry: click it to show it again, × to remove it. Two buttons
;; side by side, as a button can't hold another: GTK3 gives a button an input
;; window over its whole area, so one inside it never gets a click. The
;; eventbox gives the row a :hover for both.
(defwidget notification_entry [n]
    (eventbox
        :class "notif-entry"
        (box
            :class "notif-row"
            :space-evenly false
            ;; red on critical notifications
            (box :class "notif-accent ${n.critical ? 'critical' : ''}")
            (button
                :hexpand true
                :onclick "dunstctl history-pop ${n.id}; eww close notification_history"
                (box
                    :space-evenly false
                    ;; the app's icon, or a bell when it sent none
                    (box
                        :class "notif-icon"
                        :valign "start"
                        (image :visible {n.icon != ""} :path {n.icon}
                            :image-width 24 :image-height 24)
                        (label :visible {n.icon == ""} :text "󰂚"))
                    ;; The labels are capped to fit .notif-text's width, so
                    ;; long text is cut short rather than widening the popup
                    (box
                        :class "notif-text"
                        :orientation "v"
                        :space-evenly false
                        (box
                            :space-evenly false
                            (label :class "notif-meta" :hexpand true :xalign 0 :limit-width 40
                                :text {n.app})
                            (label :class "notif-meta" :text {n.time}))
                        (label :class "notif-summary" :xalign 0 :limit-width 38 :text {n.summary})
                        (label :class "notif-body" :xalign 0 :limit-width 43
                            :visible {n.body != ""} :text {n.body})
                    )
                )
            )
            (button
                :class "notif-dismiss"
                :valign "start"
                :onclick "dunstctl history-rm ${n.id}"
                "×")
        )
    )
)

;; Rows the history shows before it scrolls
(defvar notification_rows 6)

;; The popup hangs from the bar button like the rofi menus: TOP and RIGHT are
;; bar_anchor.py's gaps to the button's bottom and right edges. The window
;; covers the screen; everything around the card is a transparent button
;; that closes it, as rofi's click-to-exit doesn't work on Wayland either.
(defwindow notification_history [top right]
    :monitor 0
    :geometry (geometry
        :anchor "top left"
        :width "100%"
        :height "100%"
    )
    :stacking "overlay"
    :exclusive false
    :namespace "eww-notifications"

    (box
        :orientation "v"
        :space-evenly false
        ;; down to 5px below the button, the gap the rofi menus leave
        (button :class "backdrop" :height {top + 5} :onclick "eww close notification_history")
        (box
            :space-evenly false
            (button :class "backdrop" :hexpand true :onclick "eww close notification_history")
            (box
                :class "notif-card"
                :orientation "v"
                :space-evenly false
                (box
                    :class "notif-header"
                    :space-evenly false
                    (label :xalign 0 :text "Notifications")
                    (label :class "notif-total" :hexpand true :xalign 0
                        :visible {arraylength(notifications.entries) > 0}
                        :text {arraylength(notifications.entries)})
                    (button
                        :class "notif-clear"
                        :visible {arraylength(notifications.entries) > 0}
                        :onclick "dunstctl history-clear"
                        "Clear all")
                )
                (box :class "notif-divider")
                (label
                    :class "notif-empty"
                    :visible {arraylength(notifications.entries) == 0}
                    :text "No notifications")
                (scroll
                    :hscroll false
                    :visible {arraylength(notifications.entries) > 0}
                    ;; .notif-entry's height, 70px, per row
                    :height {70 * min(arraylength(notifications.entries), notification_rows)}
                    (box
                        :orientation "v"
                        :space-evenly false
                        (for n in {notifications.entries}
                            (notification_entry :n n))
                    )
                )
            )
            (button :class "backdrop" :width right :onclick "eww close notification_history")
        )
        (button :class "backdrop" :vexpand true :onclick "eww close notification_history")
    )
)
