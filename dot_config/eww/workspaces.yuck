(deflisten workspace_string :initial '{"icons": ["", "", "", "", "", "", "", "", "", ""], "special": "empty"}'
  `./scripts/workspaces.sh`)

(defwidget workspaces_w []
    (box
        :class "workspaces special-${workspace_string.special}"
        :space-evenly false
        :spacing 10

        (for icon in {workspace_string.icons}
            (label :class "ws-icon" :valign "center" :text icon))
    )
)
