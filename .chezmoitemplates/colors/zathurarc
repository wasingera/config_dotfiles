# Catppuccin {{ .name }} for zathura, included by ~/.config/zathura/zathurarc.
# Generated by chezmoi from .chezmoitemplates/colors/zathurarc.
# colorscheme-accents appends the wallpaper's accent below.

set default-bg "{{ .base }}"
set default-fg "{{ .text }}"

set statusbar-bg "{{ .mantle }}"
set statusbar-fg "{{ .subtext0 }}"
set inputbar-bg  "{{ .mantle }}"
set inputbar-fg  "{{ .text }}"

set notification-bg         "{{ .surface0 }}"
set notification-fg         "{{ .text }}"
set notification-error-bg   "{{ .surface0 }}"
set notification-error-fg   "{{ .red }}"
set notification-warning-bg "{{ .surface0 }}"
set notification-warning-fg "{{ .yellow }}"

set completion-bg           "{{ .mantle }}"
set completion-fg           "{{ .text }}"
set completion-group-bg     "{{ .crust }}"
set completion-group-fg     "{{ .subtext0 }}"
set completion-highlight-bg "{{ .blue }}"
set completion-highlight-fg "{{ .base }}"

set index-bg        "{{ .base }}"
set index-fg        "{{ .text }}"
set index-active-bg "{{ .blue }}"
set index-active-fg "{{ .base }}"

# Search matches and the forward-search marker, at 50% alpha (80) so the text shows through
set highlight-color        "{{ .overlay2 }}80"
set highlight-active-color "{{ .blue }}80"
set highlight-fg           "{{ .base }}"

set render-loading-bg "{{ .base }}"
set render-loading-fg "{{ .text }}"

# Ctrl+R recolours the pages: white becomes the background, black the text
set recolor-lightcolor "{{ .base }}"
set recolor-darkcolor  "{{ .text }}"
