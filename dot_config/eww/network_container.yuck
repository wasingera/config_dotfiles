;; icons of the active Wi-Fi (or wired) connection and VPN, updated on
;; NetworkManager events
(deflisten network :initial '{"wifi_icon": "", "vpn_icon": ""}'
    `./scripts/network.sh`)

(include "./vpn.yuck")
(include "./wifi.yuck")
(include "./bluetooth.yuck")

;; The pills get equal widths: a box spaces its children evenly by default
(defwidget network_container []
    (box
        (box
            :class "vpn"
            (vpn_widget)
        )

        (box
            :class "wifi"
            (wifi_widget)
        )

        (box
            :class "bluetooth"
            (bluetooth_widget)
        )
    )
)
