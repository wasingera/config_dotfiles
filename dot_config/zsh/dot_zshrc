## Enable Extended Globbing ##
setopt extended_glob

## Allow # Comments at the Prompt ##
## (without this, a pasted "cmd  # note" fails with "bad pattern: #" under extended_glob)
setopt interactive_comments

## Set History File and Max Entries ##
export HISTFILE="$HOME/.local/state/zsh/.zsh_history"
export SAVEHIST=10000
export HISTSIZE=10000

## Share Command History Across Shell Instances ##
setopt SHARE_HISTORY

## Load Plugins ##
fpath+=($ZDOTDIR/plugins/pure)
source $ZDOTDIR/plugins/load-plugins.zsh

## Completion ##
# after the plugins, which add to fpath (zsh-completions)
autoload -U compinit && compinit

## Prompt Setup ##
autoload -U promptinit; promptinit
prompt pure

## Aliases ##
# A "#? USAGE - DESCRIPTION" line above a command lists it in `help` (below).
# macOS's BSD ls uses -G for colour; GNU ls (Linux, WSL) uses --color
if [[ $OSTYPE == darwin* ]]; then
    alias ls="ls -Gh"
else
    alias ls="ls --color -h"
fi
# macOS has open built in; elsewhere use xdg-open when it's installed
if [[ $OSTYPE != darwin* ]] && (( $+commands[xdg-open] )); then
    #? open FILE - open with its default app (xdg-open)
    alias open="xdg-open"
fi
#? ll - long listing (ls -l)
alias ll="ls -l"
alias rm="rm -v"
alias cp="cp -v"
alias mv="mv -v"
#? vim - nvim
alias vim="nvim"
#? arduino - arduino-cli
alias arduino="arduino-cli"
#? dc - docker container
alias dc="docker container"
# alias gcc="gcc -Wall -Wconversion -Wextra -std=gnu99"
# alias g++="g++ -Wall -Wconversion -Wextra -Werror -Wshadow -std=c++11 -Weffc++ -m64"
alias g++="g++ -std=c++17"

## Functions ##
#? venv NAME - activate the Python venv ~/venv/NAME
function venv() {
    source "$HOME/venv/$1/bin/activate"
}

## tmux ##
# t: attach to the last session, or start tmux (continuum restores the saved
# sessions); inside tmux, the session picker. t NAME: go to session NAME,
# making it in this directory if needed. tn [NAME]: the same, named after this
# directory by default. tl lists sessions; tk [NAME] kills one (the current one
# by default; tmux then switches to another).
if (( $+commands[tmux] )); then
    function _t_go() {
        if [[ -n $TMUX ]]; then tmux switch-client -t "=$1"; else tmux attach -t "=$1"; fi
    }
    #? t [NAME] - go to tmux session NAME (made if needed); alone, attach or pick one
    function t() {
        if [[ -n $1 ]]; then
            tmux has-session -t "=$1" 2>/dev/null || tmux new-session -d -s "$1" || return
            _t_go "$1"
        elif [[ -n $TMUX ]]; then
            tmux display-popup -E -w 60% -h 50% ~/.config/tmux/scripts/pick-session.sh
        elif tmux has-session 2>/dev/null; then
            tmux attach
        else
            tmux
        fi
    }
    #? tn [NAME] - like t, named after this directory by default
    function tn() {
        # tmux doesn't allow . or : in a session name (as in pick-session.sh)
        t "${1:-${${PWD:t}//[.:]/_}}"
    }
    #? tl - list tmux sessions
    alias tl="tmux ls"
    #? tk [NAME] - kill tmux session NAME, or the current one
    function tk() {
        if [[ -n $1 ]]; then
            tmux kill-session -t "=$1"
        elif [[ -n $TMUX ]]; then
            tmux kill-session
        else
            print -u2 "tk: not in tmux; name a session"
            return 1
        fi
    }
    # complete session names
    if (( $+functions[compdef] )); then
        function _t_sessions() {
            local -a sessions=(${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"})
            _describe session sessions
        }
        compdef _t_sessions t tk
    fi
fi

