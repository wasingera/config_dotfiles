;; Nerd Font icon: Bluetooth off, on, or connected to a device, and whether
;; it's scanning for devices, updated on BlueZ events
(deflisten bluetooth :initial '{"icon": "", "scanning": false}'
    `./scripts/bluetooth.sh`)

(defwidget bluetooth_widget []
    (button
        :onclick `./scripts/select_bluetooth.sh &`
        (label :class "net-icon ${bluetooth.scanning ? 'scanning' : ''}"
            :text {bluetooth.icon})
    )
)
